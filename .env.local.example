# ============================================================================
# Unkast — variables d'environnement
# Copier en .env.local et remplir. Ne JAMAIS versionner .env.local.
# ============================================================================

# --- Supabase (obligatoire) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Cle service role : bypass la RLS. Serveur uniquement, jamais NEXT_PUBLIC_.
# Requise par lib/supabase/admin.ts (admin, moderation, colonnes protegees de
# profiles, webhook Stripe, garde /admin du middleware).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- URL du site (obligatoire en prod) --------------------------------------
# Utilisee par lib/stripe.ts pour construire les URLs de retour Checkout/Portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails transactionnels (Resend) ----------------------------------------
# Sans RESEND_API_KEY, lib/email.ts saute l'envoi silencieusement (pratique en
# dev, mais la confirmation d'email et les invitations ne partent pas).
RESEND_API_KEY=<resend api key>
INVITE_FROM_EMAIL=Unkast <invitations@unkast.com>
AUTH_FROM_EMAIL=Unkast <hello@unkast.com>

# --- Stripe (chantier 7 — mode TEST tant que le lancement n'est pas fait) ----
# Laisser NEXT_PUBLIC_BILLING_ENABLED a false : les boutons de paiement restent
# alors visibles pour les seuls admins, le public voit la waitlist.
NEXT_PUBLIC_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<...>
STRIPE_PRICE_MONTHLY=price_<...>
STRIPE_PRICE_YEARLY=price_<...>

# --- Notifications push (optionnel) -----------------------------------------
# JSON du compte de service Firebase, sur UNE seule ligne. Absent = push desactive.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
